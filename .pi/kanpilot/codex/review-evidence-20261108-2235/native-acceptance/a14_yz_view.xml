抄贪官污吏的家财，解决急需。而后的“摊丁入亩、火耗归公”、“士绅一体当差、一体纳粮”、“河南罢考案”、“铁帽子亲王大殿发难逼宫”、“含泪杀亲子”等一系列旨在推行新政、抑制官绅敛财和宫廷内部党争、挤压的历史事件贯穿雍正的一生和雍正王朝......" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,277][1036,442]" drawing-order="0" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="dev.mediaplayer.media_player" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,464][1080,618]" drawing-order="0" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="dev.mediaplayer.media_player" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,464][1080,618]" drawing-order="0" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="dev.mediaplayer.media_player" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,486][348,596]" drawing-order="0" hint=""><node index="0" text="" resource-id="" class="android.widget.Button" package="dev.mediaplayer.media_player" content-desc="雍正王朝" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="true" bounds="[44,486][348,596]" drawing-order="0" hint="" /></node></node></node><node index="3" text="" resource-id="" class="android.view.View" package="dev.mediaplayer.media_player" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="fa