<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标背景：铺满 108dp 画布的不透明矩形，裁剪形状交给启动器。
     渐变沿用原 mipmap-*/ic_launcher.png 底板实测值：左上 #6BC3FF → 右下 #005FDD，
     沿画布对角线（约 45°）线性过渡，无透明色停靠点。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FF6BC3FF"
                android:endColor="#FF005FDD" />
        </aapt:attr>
    </path>
</vector>
