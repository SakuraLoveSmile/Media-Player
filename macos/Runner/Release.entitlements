<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Internal distribution has no Developer ID: M0 decision is to ship
	     ad-hoc signed, unsigned-by-notarization builds with the sandbox off.
	     Re-enable together with a Developer ID. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Required for any outbound request (Emby API and media streams).
	     Verified in B2: without it every network load fails with
	     "Operation not permitted". -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
